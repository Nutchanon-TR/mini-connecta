{
  "name": "mini-connecta",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5",
    "@types/node": "24",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "scripts": {
    "format": "prettier --write apps packages scripts --ignore-unknown",
    "format:check": "prettier --check apps packages scripts --ignore-unknown",
    "lint": "eslint apps packages scripts --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @mini-connecta/db generate",
    "db:migrate": "pnpm --filter @mini-connecta/db migrate"
  }
}
